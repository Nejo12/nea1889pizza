# Store secrets only in Vercel settings or ignored .env.local.
# Runtime (server-only): Supabase TRANSACTION pooler (port 6543), role nea_runtime.
# Format: postgresql://nea_runtime.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=
NEA_DATABASE_SCHEMA=nea
# Migrations only (never set in Vercel): DIRECT or SESSION connection (port 5432), migration identity.
MIGRATION_DATABASE_URL=
# Supabase Auth (staff login). Publishable/anon key only; never put a service-role key in the app environment.
# Local stack: http://127.0.0.1:54521. Staff access = active row in nea.staff_members.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
AUTHORIZED_ORIGINS=http://localhost:3000
